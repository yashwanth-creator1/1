.login-message{min-height:20px;text-align:center;font-size:12px;color:#ff8b9a;margin:10px 0 0}
.login-switch{text-align:center;color:#8797ad;font-size:12px;margin-top:17px}
.login-switch button{border:0;background:none;color:#5ee7ff;font-weight:800;cursor:pointer}
.login-security{margin-top:17px;padding:11px 12px;border-radius:12px;background:rgba(94,231,255,.05);border:1px solid rgba(94,231,255,.08);font-size:10px;line-height:1.55;color:#8294aa}
.login-status{display:flex;align-items:center;gap:7px;margin-bottom:14px;font-size:11px;color:#8294aa}
.login-status i{width:7px;height:7px;border-radius:50%;background:#5ee7ff;box-shadow:0 0 12px #5ee7ff}
@media(max-width:820px){
  .login-wrap{grid-template-columns:1fr;max-width:500px}
  .login-brand{padding:26px;display:none}
  .login-card{padding:25px}
}

