/* Enhanced smart solver extensions: fractions, factorial, logs, powers and percent change. */
const originalSmartSolve=smartSolve;
smartSolve=function(){
  let q=$("smartInput").value.trim(), l=q.toLowerCase();
  if(!q)return fail("Enter a problem first.");

  let m=l.match(/percent(?:age)?\s*(?:change|increase|decrease)\s*(?:from\s*)?(-?\d*\.?\d+)\s*(?:to|â†’)\s*(-?\d*\.?\d+)/);
  if(m){
    let a=Number(m[1]),b=Number(m[2]);
    if(a===0)return fail("Starting value cannot be zero for percentage change.");
    let pct=(b-a)/Math.abs(a)*100;
    enhancedOut("Percentage Change",`${cleanNumber(pct)}%`,[
      `Change = ${cleanNumber(b-a)}`,
      `Percentage change = (new âˆ’ old) / |old| Ã— 100`,
      `= (${b} âˆ’ ${a}) / |${a}| Ã— 100`,
      `= ${cleanNumber(pct)}%`
    ]); enhancedSave(q,"Smart Solver"); return;
  }
  m=l.match(/^factorial\s*(\d+)$/);
  if(m){
    let n=Number(m[1]);if(n>170)return fail("For this offline calculator, factorial is limited to 170.");
    let f=1;for(let i=2;i<=n;i++)f*=i;
    enhancedOut("Factorial",String(f),[`n! = ${Array.from({length:n},(_,i)=>i+1).join(" Ã— ")}`,`${n}! = ${f}`]);
    enhancedSave(q,"Smart Solver");return;
  }
  m=l.match(/^log(?:10)?\s*\(\s*(-?\d*\.?\d+)\s*\)$/);
  if(m){
    let x=Number(m[1]);if(x<=0)return fail("Logarithm input must be positive.");
    let a=/^log10/.test(l)?Math.log10(x):Math.log10(x);
    enhancedOut("Logarithm",cleanNumber(a),[`logâ‚â‚€(${x}) = ${cleanNumber(a)}`]);enhancedSave(q,"Smart Solver");return;
  }
  m=l.match(/^(\d*\.?\d+)\s*\/\s*(\d*\.?\d+)$/);
  if(m){
    let a=Number(m[1]),b=Number(m[2]);if(b===0)return fail("Cannot divide by zero.");
    let g=(x,y)=>{while(y){[x,y]=[y,x%y]}return Math.abs(x)};
    let ga=g(Math.round(a),Math.round(b));
    enhancedOut("Fraction",`${cleanNumber(a/b)}`,[
      `Numerator = ${a}`,`Denominator = ${b}`,`Decimal value = ${cleanNumber(a/b)}`,
      Number.isInteger(a)&&Number.isInteger(b)?`Simplified fraction = ${a/ga}/${b/ga}`:""
    ].filter(Boolean));enhancedSave(q,"Smart Solver");return;
  }
  originalSmartSolve();
};

