function chemistrySolve(){
  let type=$("chemType").value;
  let a=Number($("ch0").value);
  let b=$("ch1")?Number($("ch1").value):0;
  let c=$("ch2")?Number($("ch2").value):0;
  let d=$("ch3")?Number($("ch3").value):0;

  if(type==="moles"){
    if(b===0)return fail("Molar mass cannot be zero.");
    const ans=a/b;
    return out("Chemistry â€” Moles",`${cleanNumber(ans)} mol`,[`n = mass / molar mass`,`n = ${a} / ${b}`,`n = ${cleanNumber(ans)} mol`]);
  }
  if(type==="mass"){
    const ans=a*b;
    return out("Chemistry â€” Mass",`${cleanNumber(ans)} g`,[`m = nM`,`m = ${a} Ã— ${b}`,`m = ${cleanNumber(ans)} g`]);
  }
  if(type==="molarity"){
    if(b===0)return fail("Volume cannot be zero.");
    const ans=a/b;
    return out("Chemistry â€” Molarity",`${cleanNumber(ans)} mol/L`,[`M = n/V`,`M = ${a} / ${b}`,`M = ${cleanNumber(ans)} mol/L`]);
  }
  if(type==="molality"){
    if(b===0)return fail("Solvent mass cannot be zero.");
    const ans=a/b;
    return out("Chemistry â€” Molality",`${cleanNumber(ans)} mol/kg`,[`m = moles of solute / kg of solvent`,`m = ${a} / ${b}`,`m = ${cleanNumber(ans)} mol/kg`]);
  }
  if(type==="molefraction"){
    if(b<=0 || a<0 || a>b)return fail("Check component and total moles.");
    const ans=a/b;
    return out("Chemistry â€” Mole Fraction",`X = ${cleanNumber(ans)}`,[`X = náµ¢ / n(total)`,`X = ${a} / ${b}`,`X = ${cleanNumber(ans)}`]);
  }
  if(type==="dilution"){
    if(c===0)return fail("Câ‚‚ cannot be zero.");
    const ans=(a*b)/c;
    return out("Chemistry â€” Dilution",`Vâ‚‚ = ${cleanNumber(ans)}`,[`Câ‚Vâ‚ = Câ‚‚Vâ‚‚`,`Vâ‚‚ = (${a} Ã— ${b}) / ${c}`,`Vâ‚‚ = ${cleanNumber(ans)}`]);
  }
  if(type==="gas"){
    if(d===0)return fail("Temperature cannot be zero.");
    const R=8.314;
    const ans=(a*b)/(c*R);
    return out("Chemistry â€” Ideal Gas Law",`n = ${cleanNumber(ans)} mol`,[`PV = nRT`,`n = PV / RT = (${a} Ã— ${b}) / (${c} Ã— ${R})`,`n = ${cleanNumber(ans)} mol`]);
  }
  if(type==="ph"){
    if(a<=0)return fail("[Hâº] must be greater than zero.");
    const ans=-Math.log10(a);
    return out("Chemistry â€” pH",`pH = ${cleanNumber(ans)}`,[`pH = âˆ’logâ‚â‚€[Hâº]`,`pH = âˆ’logâ‚â‚€(${a})`,`pH = ${cleanNumber(ans)}`]);
  }
  if(type==="colligative_bp"){
    const delta=a*b*c, bp=d+delta;
    return out("Boiling Point Elevation",`Î”Tb = ${cleanNumber(delta)} K; New bp = ${cleanNumber(bp)} Â°C`,[`Î”Tb = iKb m`,`Î”Tb = ${a} Ã— ${b} Ã— ${c}`,`Î”Tb = ${cleanNumber(delta)} K`,`Táµ¦(solution) = Táµ¦Â° + Î”Tb = ${cleanNumber(bp)} Â°C`]);
  }
  if(type==="colligative_fp"){
    const delta=a*b*c, fp=d-delta;
    return out("Freezing Point Depression",`Î”Tf = ${cleanNumber(delta)} K; New fp = ${cleanNumber(fp)} Â°C`,[`Î”Tf = iKf m`,`Î”Tf = ${a} Ã— ${b} Ã— ${c}`,`Î”Tf = ${cleanNumber(delta)} K`,`Tf(solution) = TfÂ° âˆ’ Î”Tf = ${cleanNumber(fp)} Â°C`]);
  }
  if(type==="osmotic"){
    const R=8.314, pi=a*b*R*c;
    return out("Osmotic Pressure",`Ï€ = ${cleanNumber(pi)} kPa`,[`Ï€ = iMRT`,`Ï€ = ${a} Ã— ${b} Ã— ${R} Ã— ${c}`,`Ï€ = ${cleanNumber(pi)} kPa`]);
  }
  if(type==="raoult"){
    if(a<0 || a>1 || b<0)return fail("Use 0 â‰¤ solvent mole fraction â‰¤ 1 and a non-negative pressure.");
    const p=a*b, lowering=b-p;
    return out("Raoult's Law",`P(solution) = ${cleanNumber(p)}`,[`P = Xsolvent Ã— PÂ°solvent`,`P = ${a} Ã— ${b}`,`P(solution) = ${cleanNumber(p)}`,`Vapour-pressure lowering = ${cleanNumber(lowering)}`]);
  }
  if(type==="solution_ppm"){
    if(b<=0)return fail("Solution amount must be greater than zero.");
    const ans=a/b;
    return out("Chemistry â€” Solution Concentration",`${cleanNumber(ans)} ppm (when mg/L or mg/kg)`,[`ppm = parts of solute per million parts of solution`,`For dilute water: ppm â‰ˆ mg/L`,`ppm value = ${cleanNumber(ans)}`]);
  }
  if(type==="solution_masspercent"){
    if(b<=0)return fail("Mass of solution must be greater than zero.");
    const ans=100*a/b;
    return out("Chemistry â€” Mass Percentage",`${cleanNumber(ans)}%`,[`Mass % = (mass of solute / mass of solution) Ã— 100`,`Mass % = (${a}/${b}) Ã— 100`,`Mass % = ${cleanNumber(ans)}%`]);
  }
  if(type==="atom_structure"){
    if(a<0 || b<a || !Number.isInteger(a) || !Number.isInteger(b))return fail("Use valid whole-number atomic and mass numbers with A â‰¥ Z.");
    const neutrons=b-a;
    return out("Journey Inside the Atom",`p = ${a}, n = ${neutrons}, e = ${a}`,[`Atomic number Z = protons = ${a}`,`Mass number A = protons + neutrons = ${b}`,`Neutrons = A âˆ’ Z = ${neutrons}`,`For a neutral atom, electrons = protons = ${a}`]);
  }
  if(type==="carbon"){
    if(a<0 || b<=0)return fail("Enter a valid carbon mass and molar mass.");
    const n=a/b, co2=n*44.0095;
    return out("Carbon â€” Complete Combustion",`${cleanNumber(co2)} g COâ‚‚`,[`C + Oâ‚‚ â†’ COâ‚‚`,`Moles of C = mass / molar mass = ${cleanNumber(n)} mol`,`1 mol C produces 1 mol COâ‚‚`,`COâ‚‚ mass = ${cleanNumber(co2)} g`]);
  }
  if(type==="bonding"){
    const charge=b;
    return out("Chemical Bonding",`Formal charge = ${cleanNumber(charge)}`,[`Formal charge = valence electrons âˆ’ nonbonding electrons âˆ’ number of bonds`,`Use Lewis structures to count these electrons/bonds`,`Calculated formal charge = ${cleanNumber(charge)}`]);
  }
  if(type==="molarity_from_mass"){
    if(b===0||c===0)return fail("Molar mass and volume must be non-zero.");
    const moles=a/b, M=moles/c;
    return out("Chemistry â€” Molarity from Mass",`M = ${cleanNumber(M)} mol/L`,[`n = mass/molar mass = ${a}/${b} = ${cleanNumber(moles)} mol`,`M = n/V = ${cleanNumber(moles)}/${c}`,`M = ${cleanNumber(M)} mol/L`]);
  }
  if(type==="electron_config"){
    if(a<0||!Number.isInteger(a))return fail("Enter a non-negative whole number of electrons.");
    const caps=[2,8,18,32,32,18,8], shells=[]; let left=a;
    for(const cap of caps){if(left<=0)break; const n=Math.min(left,cap); shells.push(n); left-=n;}
    if(left>0)shells.push(left);
    return out("Electron Shell Distribution",shells.join(", "),[`Electrons = ${a}`,`Simplified shell filling: ${shells.join(" + ")}`,`Shell distribution = ${shells.join(", ")}`]);
  }
  if(type==="heat_chem"){
    ans=a*b*c;
    return out("Chemistry â€” Heat Energy",`${cleanNumber(ans)} J`,[`q = mcÎ”T`,`q = ${a} Ã— ${b} Ã— ${c}`,`q = ${cleanNumber(ans)} J`]);
  }
  if(type==="enthalpy"){
    if(b===0)return fail("Moles cannot be zero.");
    ans=a/b;
    return out("Chemistry â€” Molar Enthalpy",`Î”H = ${cleanNumber(ans)} kJ/mol`,[`Î”H = q/n`,`Î”H = ${a}/${b}`,`Î”H = ${cleanNumber(ans)} kJ/mol`]);
  }
  if(type==="equilibrium_kc"){
    if(b===0)return fail("Reactant concentration term cannot be zero.");
    ans=a/b;
    return out("Chemistry â€” Equilibrium Kc",`Kc = ${cleanNumber(ans)}`,[`Kc = product concentration term / reactant concentration term`,`Kc = ${a}/${b}`,`Kc = ${cleanNumber(ans)}`]);
  }
  if(type==="nernst"){
    if(b===0||c<=0)return fail("Electron count must be non-zero and Q must be positive.");
    ans=a-(0.05916/b)*Math.log10(c);
    return out("Chemistry â€” Nernst Equation",`E = ${cleanNumber(ans)} V`,[`E = EÂ° âˆ’ (0.05916/n)logâ‚â‚€Q`,`E = ${a} âˆ’ (0.05916/${b})logâ‚â‚€(${c})`,`E = ${cleanNumber(ans)} V`]);
  }
  if(type==="electrolysis"){
    if(d===0)return fail("Electron count cannot be zero.");
    const F=96485; ans=a*b*c/(d*F);
    return out("Chemistry â€” Electrolysis",`Mass = ${cleanNumber(ans)} g`,[`m = ItM/(nF)`,`m = ${a}Ã—${b}Ã—${c}/(${d}Ã—${F})`,`m = ${cleanNumber(ans)} g`]);
  }
  if(type==="combustion_co2"){
    if(a<0)return fail("Mass cannot be negative.");
    const n=a/16.04, co2=n*44.0095;
    return out("Methane Combustion",`${cleanNumber(co2)} g COâ‚‚`,[`CHâ‚„ + 2Oâ‚‚ â†’ COâ‚‚ + 2Hâ‚‚O`,`n(CHâ‚„) = ${a}/16.04 = ${cleanNumber(n)} mol`,`1 mol CHâ‚„ â†’ 1 mol COâ‚‚`,`COâ‚‚ mass = ${cleanNumber(co2)} g`]);
  }
}

