<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --bg:#07111f;
  --card:#0d1b2e;
  --card2:#10243b;
  --text:#eef6ff;
  --muted:#9fb3c8;
  --accent:#5ee7ff;
  --accent2:#8b7cff;
  --good:#45e6a5;
  --danger:#ff6b81;
  --border:rgba(255,255,255,.1);
}

body{
  font-family:Inter,Arial,sans-serif;
  background:
    radial-gradient(circle at 15% 10%,rgba(94,231,255,.14),transparent 30%),
    radial-gradient(circle at 90% 20%,rgba(139,124,255,.16),transparent 30%),
    var(--bg);
  color:var(--text);
  min-height:100vh;
}

header{
  padding:24px;
  border-bottom:1px solid var(--border);
  background:rgba(7,17,31,.78);
  backdrop-filter:blur(15px);
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  font-size:25px;
  font-weight:900;
}

.logo span{color:var(--accent)}

header p{
  color:var(--muted);
  margin-top:5px;
}

.app{
  display:grid;
  grid-template-columns:260px 1fr;
  max-width:1500px;
  margin:auto;
}

aside{
  min-height:calc(100vh - 100px);
  padding:20px;
  border-right:1px solid var(--border);
}

.tool{
  width:100%;
  border:1px solid transparent;
  background:transparent;
  color:var(--muted);
  padding:13px;
  border-radius:12px;
  text-align:left;
  margin-bottom:7px;
  cursor:pointer;
  font-size:14px;
}

.tool:hover,.tool.active{
  color:white;
  background:linear-gradient(90deg,rgba(94,231,255,.13),rgba(139,124,255,.12));
  border-color:var(--border);
}

main{
  padding:30px;
}

.hero{
  padding:30px;
  border:1px solid var(--border);
  border-radius:24px;
  background:linear-gradient(135deg,rgba(94,231,255,.09),rgba(139,124,255,.09));
  margin-bottom:20px;
}

.hero h1{
  font-size:clamp(30px,5vw,55px);
  line-height:1;
}

.hero h1 span{
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;
  color:transparent;
}

.hero p{
  margin-top:15px;
  color:var(--muted);
  max-width:800px;
  line-height:1.6;
}

.card{
  background:rgba(13,27,46,.9);
  border:1px solid var(--border);
  border-radius:20px;
  padding:22px;
  margin-bottom:18px;
  box-shadow:0 15px 40px rgba(0,0,0,.18);
}

label{
  display:block;
  color:var(--muted);
  font-size:13px;
  margin:12px 0 7px;
}

input,textarea,select{
  width:100%;
  border:1px solid var(--border);
  background:#071525;
  color:white;
  padding:13px;
  border-radius:12px;
  outline:none;
  font-size:15px;
}

textarea{
  min-height:145px;
  resize:vertical;
}

input:focus,textarea:focus,select:focus{
  border-color:var(--accent);
}

button{
  border:0;
  cursor:pointer;
}

.primary{
  margin-top:15px;
  padding:14px 22px;
  border-radius:12px;
  color:#001019;
  font-weight:900;
  background:linear-gradient(90deg,var(--accent),#a8f3ff);
}

.secondary{
  padding:10px 14px;
  border-radius:10px;
  background:#172b43;
  color:white;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:12px;
}

.result{
  border-left:4px solid var(--good);
  background:#09192a;
  padding:18px;
  border-radius:12px;
  line-height:1.7;
}

.result h3{
  color:var(--accent);
  margin-bottom:8px;
}

.error{
  border-left-color:var(--danger);
}

.step{
  padding:12px;
  margin:8px 0;
  border-radius:10px;
  background:#10243b;
}

.answer{
  font-size:25px;
  font-weight:900;
  color:var(--good);
  margin:8px 0 15px;
}

.history-item{
  padding:12px;
  border-bottom:1px solid var(--border);
  cursor:pointer;
}

.history-item:hover{
  background:#10243b;
}

.badge{
  display:inline-block;
  padding:5px 9px;
  border-radius:20px;
  background:#172b43;
  color:var(--accent);
  font-size:11px;
  margin:3px;
}

footer{
  text-align:center;
  padding:25px;
  color:var(--muted);
}

@media(max-width:800px){
  .app{grid-template-columns:1fr}
  aside{
    min-height:auto;
    border-right:0;
    border-bottom:1px solid var(--border);
    overflow-x:auto;
    display:flex;
    gap:7px;
  }
  .tool{
    min-width:max-content;
    margin:0;
  }
  main{padding:15px}
}


/* ===== SUBJECT STUDY DESIGN ===== */
.subject-study{margin-top:18px}
.subject-study-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}
.subject-study-head p{color:var(--muted);font-size:13px;line-height:1.5;margin-top:4px}
.subject-topic-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.subject-topic{padding:14px;border:1px solid var(--border);border-radius:15px;background:linear-gradient(135deg,rgba(94,231,255,.07),rgba(139,124,255,.07));cursor:pointer;transition:.18s}
.subject-topic:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 12px 25px #0003}
.subject-topic b{display:block;margin-bottom:5px}
.subject-topic span{display:block;color:var(--muted);font-size:11px;line-height:1.4}
.subject-topic .topic-pill{display:inline-block;margin-top:9px;padding:4px 8px;border-radius:99px;background:var(--glass);color:var(--accent);font-size:10px}
.physics-accent{border-top:3px solid #5ee7ff}
.chemistry-accent{border-top:3px solid #45e6a5}
.subject-select{margin-top:8px}

/* ===== ADVANCED PRO UI ===== */
:root{
  --accent:#5ee7ff;
  --accent2:#8b7cff;
  --good:#45e6a5;
  --danger:#ff6b81;
  --warning:#ffd166;
  --glass:rgba(255,255,255,.045);
}
*{scrollbar-width:thin;scrollbar-color:#29415e transparent}
body{overflow-x:hidden}
body.light{
  --bg:#eef5fb;--card:#fff;--card2:#f3f7fb;--text:#102033;--muted:#587089;
  --border:rgba(16,32,51,.12);
  background:linear-gradient(135deg,#eef7ff,#f7f2ff);
}
body.light header{background:rgba(255,255,255,.82)}
body.light input,body.light textarea,body.light select{background:#f8fbff;color:#102033}
body.light .result,body.light .step{background:#f4f8fc}
body.light .secondary{background:#e6eef7;color:#102033}
header{display:flex;align-items:center;justify-content:space-between;gap:18px}
.header-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.icon-btn{padding:10px 12px;border:1px solid var(--border);border-radius:11px;background:var(--glass);color:var(--text);font-size:16px}
.app{position:relative}
aside{position:sticky;top:92px;height:calc(100vh - 92px);overflow:auto}
.tool{transition:.18s transform,.18s background}
.tool:active{transform:scale(.97)}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:10px;margin:0 0 18px}
.kpi{padding:15px;border:1px solid var(--border);border-radius:16px;background:var(--glass)}
.kpi b{display:block;font-size:22px;margin-top:4px}
.kpi small{color:var(--muted)}
.quick-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.quick{padding:14px;border:1px solid var(--border);background:var(--glass);border-radius:14px;color:var(--text);text-align:left}
.quick:hover{border-color:var(--accent);transform:translateY(-1px)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.toolbar button{padding:9px 12px;border-radius:10px;background:#172b43;color:white}
body.light .toolbar button{background:#e7eef7;color:#102033}
.search-box{position:relative;margin-bottom:12px}
.search-box input{padding-left:38px}
.search-icon{position:absolute;left:13px;top:13px;color:var(--muted)}
.progress{height:5px;background:rgba(255,255,255,.08);border-radius:99px;overflow:hidden;margin-top:12px}
.progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:.25s}
#toast{position:fixed;right:18px;bottom:18px;z-index:100;max-width:330px;padding:13px 16px;border-radius:12px;background:#132940;color:white;border:1px solid var(--border);box-shadow:0 12px 35px #0005;opacity:0;transform:translateY(12px);pointer-events:none;transition:.25s}
#toast.show{opacity:1;transform:none}
.command-palette{position:fixed;inset:0;background:#0008;z-index:90;display:none;align-items:flex-start;justify-content:center;padding:10vh 18px}
.command-palette.show{display:flex}
.palette{width:min(680px,100%);background:var(--card);border:1px solid var(--border);border-radius:18px;padding:15px;box-shadow:0 30px 80px #0008}
.palette-list button{display:block;width:100%;text-align:left;padding:12px;border-radius:10px;background:transparent;color:var(--text);margin-top:5px}
.palette-list button:hover{background:var(--glass)}
.chip-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.chip{padding:7px 10px;border-radius:99px;border:1px solid var(--border);background:var(--glass);color:var(--muted);cursor:pointer}
.output-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.output-actions button{padding:9px 12px;border-radius:10px;background:#172b43;color:#fff}
body.light .output-actions button{background:#e7eef7;color:#102033}
.empty-state{text-align:center;padding:28px;color:var(--muted)}
@media(max-width:800px){
  header{padding:16px}
  header p{display:none}
  .header-actions{margin-left:auto}
  aside{position:relative;top:auto;height:auto}
  .hero{padding:22px}
}


.topic-section{margin-top:18px}
.topic-header{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px}
.topic-header small{color:var(--muted)}
.topic-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:13px}
.topic-card{border:1px solid var(--border);border-radius:18px;background:linear-gradient(135deg,rgba(94,231,255,.055),rgba(139,124,255,.055));padding:18px;cursor:pointer;transition:.2s;min-height:145px}
.topic-card:hover{transform:translateY(-3px);border-color:rgba(94,231,255,.4);box-shadow:0 14px 30px #0003}
.topic-card .topic-icon{font-size:27px}
.topic-card h3{margin:9px 0 5px}
.topic-card p{color:var(--muted);font-size:13px;line-height:1.5}
.topic-card .count{display:inline-block;margin-top:10px;padding:4px 8px;border-radius:99px;background:var(--glass);font-size:11px;color:var(--accent)}
.lesson-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.lesson{padding:14px;border:1px solid var(--border);border-radius:13px;background:var(--glass)}
.lesson b{display:block;margin-bottom:5px}
.lesson span{font-size:12px;color:var(--muted)}
.formula{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding:12px;border-radius:12px;background:#06111e;border:1px solid var(--border);overflow:auto;margin:8px 0}
body.light .formula{background:#edf3f8}
.topic-tabs{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}
.topic-tabs button{padding:8px 11px;border-radius:99px;border:1px solid var(--border);background:var(--glass);color:var(--text)}
.topic-tabs button.active{border-color:var(--accent);color:var(--accent)}


/* ===== ACCOUNT / LOGIN SYSTEM ===== */
.account-bar{display:flex;align-items:center;gap:10px;margin-left:auto}
.account-avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:#07121d;font-weight:800}
.account-name{font-weight:700}
.auth-overlay{position:fixed;inset:0;z-index:9999;background:rgba(2,8,15,.78);backdrop-filter:blur(10px);display:grid;place-items:center;padding:20px}
.auth-box{width:min(430px,100%);background:var(--panel,#101b2b);border:1px solid var(--border);border-radius:24px;padding:25px;box-shadow:0 30px 90px #0008}
.auth-logo{font-size:38px;text-align:center;margin-bottom:4px}
.auth-box h2{text-align:center;margin:4px 0 7px}
.auth-sub{text-align:center;color:var(--muted);font-size:13px;margin-bottom:20px}
.auth-field{margin:12px 0}
.auth-field label{display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--muted)}
.auth-field input{width:100%;box-sizing:border-box;padding:12px 13px;border-radius:12px;border:1px solid var(--border);background:var(--glass);color:var(--text);outline:none}
.auth-field input:focus{border-color:var(--accent)}
.auth-actions{display:grid;gap:9px;margin-top:16px}
.auth-error{min-height:18px;color:#ff7b8a;font-size:12px;text-align:center;margin-top:9px}
.auth-switch{text-align:center;color:var(--muted);font-size:12px;margin-top:15px}
.auth-switch button{border:0;background:none;color:var(--accent);cursor:pointer;font-weight:700}
.account-panel{position:fixed;right:18px;top:70px;z-index:9000;width:250px;padding:16px;border:1px solid var(--border);border-radius:17px;background:var(--panel,#101b2b);box-shadow:0 20px 60px #0007;display:none}
.account-panel.show{display:block}
.account-panel h4{margin:0 0 4px}
